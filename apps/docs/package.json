{
  "name": "libravel-ui",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "build": "bun run build:registry && bun run build:themes && bun run next build",
    "dev": "bun run next dev --turbo",
    "dev:stable": "cross-env BUN_JSC_forceRAMSize=2147483648 bun run next dev --turbo",
    "dev:lite": "cross-env BUN_JSC_forceRAMSize=536870912 bun --smol next dev",
    "dev:all": "bun run build:registry && bun run build:themes && bun run next dev --turbo",
    "start": "bun run next start",
    "postinstall": "bun x fumadocs-mdx",
    "lint": "bun run eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "build:registry": "bun x tsx src/scripts/build-registry/index.ts",
    "build:themes": "bun x tsx src/scripts/build-themes.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
